#version 450
// SwiGLU-style fused activation: D[i] = silu(A[i]) * B[i]
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, set = 0, binding = 2) writeonly buffer BufD { float d[]; };

layout(push_constant) uniform Push {
    uvec4 dims;   // x = element count
    vec4  flags;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dims.x) return;
    float x = a[i];
    d[i] = (x / (1.0 + exp(-x))) * b[i];
}
