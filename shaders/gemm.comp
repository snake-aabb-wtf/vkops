#version 450
// Tiled GEMM: D[M,N] = act(A[M,K] @ B[K,N] (+ C[N] bias))
//   B layout: if pc.flags.y != 0 -> B is [N,K] (row-major, i.e. W^T in memory, PyTorch nn.Linear style),
//             else B is [K,N] row-major.
//   act: 0 none, 1 relu, 2 gelu(tanh), 3 silu
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, set = 0, binding = 2) readonly buffer BufC { float c[]; };
layout(std430, set = 0, binding = 3) writeonly buffer BufD { float d[]; };

layout(push_constant) uniform Push {
    uvec4 dims;   // x=M, y=N, z=K, w=has_bias
    vec4  flags;  // x=activation, y=b_transposed
} pc;

shared float As[16][16];
shared float Bs[16][16];

void main() {
    uint M = pc.dims.x;
    uint N = pc.dims.y;
    uint K = pc.dims.z;
    uint bT = pc.flags.y != 0.0 ? 1u : 0u;

    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    uint col = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint ty  = gl_LocalInvocationID.y;
    uint tx  = gl_LocalInvocationID.x;

    float acc = 0.0;
    for (uint t = 0u; t < K; t += 16u) {
        uint ac = t + tx;   // A column to load
        uint br = t + ty;   // B row to load
        As[ty][tx] = (row < M && ac < K) ? a[row * K + ac] : 0.0;
        Bs[ty][tx] = (br < K && col < N) ? (bT != 0u ? b[col * K + br] : b[br * N + col]) : 0.0;
        barrier();
        for (uint k = 0u; k < 16u; ++k) {
            acc += As[ty][k] * Bs[k][tx];
        }
        barrier();
    }

    if (row < M && col < N) {
        if (pc.dims.w != 0u) acc += c[col];
        uint act = uint(pc.flags.x);
        if (act == 1u) {
            acc = max(acc, 0.0);
        } else if (act == 2u) {
            float x2 = acc * acc;
            acc = 0.5 * acc * (1.0 + tanh(0.7978845608028654 * (acc + 0.044715 * x2)));
        } else if (act == 3u) {
            acc = acc / (1.0 + exp(-acc));
        }
        d[row * N + col] = acc;
    }
}
